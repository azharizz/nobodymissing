        { "personId": "rina", "meds": [
          { "generic": "metformin", "strength": "500 mg", "doseAsWritten": "1 tablet after meal", "timesPerDay": 2, "qtyLeft": 10 } ] },
        { "personId": "sari", "meds": [
          { "generic": "paracetamol", "strength": "500 mg", "doseAsWritten": "1 tablet", "timesPerDay": 3, "qtyLeft": 9 },
          { "generic": "levetiracetam", "strength": "500 mg", "doseAsWritten": "1 tablet", "timesPerDay": 2, "qtyLeft": 3 },
