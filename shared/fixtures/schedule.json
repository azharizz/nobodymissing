          { "generic": "insulin glargine", "strength": "100 units/ml", "people": 1 },
          { "generic": "levetiracetam", "strength": "500 mg", "people": 1 } ],
        "unscheduled": 1
      } }
  ],
  "requestCases": [
    { "name": "combine shortages from 3 shelters by generic + strength + form, counts only",
      "input": { "shelters": [
        { "shelterId": "SD3", "items": [ { "generic": "insulin glargine", "strength": "100 units/ml", "form": "pen", "qty": 2 }, { "generic": "amlodipine", "strength": "5 mg", "form": "tablet", "qty": 30 } ] },
        { "shelterId": "MSJ1", "items": [ { "generic": "amlodipine", "strength": "5 mg", "form": "tablet", "qty": 60 } ] },
        { "shelterId": "SD1", "items": [ { "generic": "amlodipine", "strength": "10 mg", "form": "tablet", "qty": 10 }, { "generic": "insulin glargine", "strength": "100 units/ml", "form": "pen", "qty": 1 } ] }
      ] },
      "expected": { "fromShelters": ["MSJ1", "SD1", "SD3"], "items": [
        { "generic": "amlodipine", "strength": "10 mg", "form": "tablet", "qty": 10 },
        { "generic": "amlodipine", "strength": "5 mg", "form": "tablet", "qty": 90 },
        { "generic": "insulin glargine", "strength": "100 units/ml", "form": "pen", "qty": 3 } ] } }
  ]
