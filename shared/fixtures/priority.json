{
  "rule": "Field Check priority (PRODUCT.md 6.11c). Uses shared/rules/defaults.json fieldPriority.",
  "cases": [
    { "name": "Pak Hasan: deep flood, cannot walk, insulin 1 day, alone, never checked",
      "input": { "event": "flood", "person": { "age": 82, "mobility": 3, "cantMiss": true, "supplyDays": 1, "alone": true, "hoursSinceContact": null, "hazard": { "floodClass": 3 } } },
      "expected": { "score": 15, "tier": "P1", "why": ["hazard at location", "limited mobility", "can't-miss treatment, 1 day(s) left", "lives alone", "never checked"] } },
    { "name": "unknown location + can't-miss is P1 by override",
      "input": { "event": "flood", "person": { "cantMiss": true, "supplyDays": 5, "hoursSinceContact": 2, "hazard": { "unknown": true } } },
      "expected": { "score": 6, "tier": "P1", "why": ["hazard at location", "location unknown", "can't-miss treatment, 5 day(s) left"] } },
    { "name": "healthy person on high ground is P3",
      "input": { "event": "flood", "person": { "age": 70, "mobility": 0, "hoursSinceContact": 2, "hazard": { "hand": 15 } } },
      "expected": { "score": 0, "tier": "P3", "why": [] } },
    { "name": "tsunami zone does not count for a flood event",
      "input": { "event": "flood", "person": { "hoursSinceContact": 1, "hazard": { "tsunamiZone": true } } },
      "expected": { "score": 0, "tier": "P3", "why": [] } },
    { "name": "tsunami zone counts for a tsunami event",
      "input": { "event": "tsunami", "person": { "hoursSinceContact": 1, "hazard": { "tsunamiZone": true } } },
      "expected": { "score": 3, "tier": "P3", "why": ["hazard at location"] } },
    { "name": "HAND below 2 m = 3",
      "input": { "event": "flood", "person": { "hoursSinceContact": 1, "hazard": { "hand": 1.5 } } },
      "expected": { "score": 3, "tier": "P3", "why": ["hazard at location"] } },
    { "name": "HAND 2-5 m = 2",
      "input": { "event": "flood", "person": { "hoursSinceContact": 1, "hazard": { "hand": 4 } } },
      "expected": { "score": 2, "tier": "P3", "why": ["hazard at location"] } },
    { "name": "HAND exactly 10 m = 1",
      "input": { "event": "flood", "person": { "hoursSinceContact": 1, "hazard": { "hand": 10 } } },
      "expected": { "score": 1, "tier": "P3", "why": [] } },
    { "name": "HAND above 10 m = 0",
      "input": { "event": "flood", "person": { "hoursSinceContact": 1, "hazard": { "hand": 10.5 } } },
      "expected": { "score": 0, "tier": "P3", "why": [] } },
    { "name": "landslide high counts in an earthquake, plus a volunteer pin nearby",
      "input": { "event": "earthquake", "person": { "hoursSinceContact": 1, "hazard": { "landslideHigh": true, "pinNearby": true } } },
      "expected": { "score": 4, "tier": "P3", "why": ["hazard at location"] } },
    { "name": "dementia + hearing + age 90 + last contact 30 h ago = P2",
      "input": { "event": "flood", "person": { "age": 90, "hearing": true, "dementia": true, "hoursSinceContact": 30, "hazard": { "floodClass": 0 } } },
      "expected": { "score": 6, "tier": "P2", "why": ["hard of hearing", "dementia"] } },
    { "name": "daily meds add 1 point, no why",
      "input": { "event": "flood", "person": { "dailyMeds": true, "mobility": 1, "hoursSinceContact": 3, "hazard": { "floodClass": 1 } } },
      "expected": { "score": 3, "tier": "P3", "why": [] } },
    { "name": "cannot walk + hazard 2 is P1 by override even with a low score",
      "input": { "event": "flood", "person": { "mobility": 3, "hoursSinceContact": 1, "hazard": { "floodClass": 2 } } },
      "expected": { "score": 5, "tier": "P1", "why": ["hazard at location", "limited mobility"] } },
    { "name": "staff override wins over the score",
      "input": { "event": "flood", "person": { "age": 82, "mobility": 3, "cantMiss": true, "supplyDays": 1, "alone": true, "hoursSinceContact": null, "hazard": { "floodClass": 3 }, "override": { "tier": "P3", "reason": "family confirmed safe upstairs" } } },
      "expected": { "score": 15, "tier": "P3", "why": ["hazard at location", "limited mobility", "can't-miss treatment, 1 day(s) left", "lives alone", "never checked", "staff override: family confirmed safe upstairs"] } }
  ],
  "sortCases": [
    { "name": "same tier: higher score first, then nearer first",
      "input": { "event": "flood", "people": [
        { "id": "A", "distanceM": 900,  "person": { "age": 82, "mobility": 3, "cantMiss": true, "supplyDays": 1, "alone": true, "hoursSinceContact": null, "hazard": { "floodClass": 3 } } },
        { "id": "B", "distanceM": 300,  "person": { "age": 82, "mobility": 3, "cantMiss": true, "supplyDays": 1, "alone": true, "hoursSinceContact": null, "hazard": { "floodClass": 3 } } },
        { "id": "C", "distanceM": 10,   "person": { "age": 90, "hearing": true, "dementia": true, "hoursSinceContact": 30, "hazard": { "floodClass": 0 } } },
        { "id": "D", "distanceM": 5000, "person": { "age": 90, "mobility": 3, "cantMiss": true, "supplyDays": 0, "alone": true, "dementia": true, "hearing": true, "hoursSinceContact": null, "hazard": { "floodClass": 3, "pinNearby": true } } },
        { "id": "E", "distanceM": null, "person": { "hoursSinceContact": 1, "hazard": { "hand": 20 } } }
      ] },
      "expected": ["D", "B", "A", "C", "E"] }
  ]
}
