{
  "_comment": "Hybrid AI safety contracts (medicine check, find open, Ask Kit). Same cases run in Vitest and JUnit.",
  "medCheckInput": [
    {
      "name": "names, beds and photos never leave",
      "input": {
        "meds": [
          {
            "nameAsWritten": "Lantus",
            "strength": "100 units/ml",
            "doseAsWritten": "10 unit malam",
            "generic": "insulin glargine",
            "confirmedBy": "family",
            "personName": "Pak Hasan Basri",
            "bed": "Bed 4",
            "photo": "data:image/jpeg;base64,AAAA"
          },
          {
            "nameAsWritten": "Amlodipin 5 mg",
            "strength": "5 mg",
            "doseAsWritten": "1 x 1",
            "generic": null,
            "confirmedBy": null
          }
        ]
      },
      "expected": {
        "meds": [
          {
            "name": "insulin glargine",
            "strength": "100 units/ml"
          },
          {
            "name": "Amlodipin 5 mg",
            "strength": "5 mg"
          }
        ]
      }
    }
  ],
  "coarseLocation": [
    {
      "input": {
        "lat": 5.55412,
        "lng": 95.31791,
        "decimals": 2
      },
      "expected": {
        "lat": 5.55,
        "lng": 95.32
      }
    },
    {
      "input": {
        "lat": -6.20005,
        "lng": 106.84499,
        "decimals": 2
      },
      "expected": {
        "lat": -6.2,
        "lng": 106.84
      }
    }
  ],
  "crossCheck": [
    {
      "name": "cloud generic agrees with offline list, unknown stays unknown, disagreement is flagged",
      "input": {
        "items": [
          {
            "name": "Lantus",
            "generic": "insulin glargine"
          },
          {
            "name": "Amlodipin 5 mg",
            "generic": "amlodipine"
          },
          {
            "name": "Glucophage",
            "generic": "glibenclamide"
          },
          {
            "name": "Zzyx",
            "generic": "made-up-ol"
          }
        ]
      },
      "expected": [
        {
          "name": "Lantus",
          "offline": "insulin glargine",
          "status": "agree"
        },
        {
          "name": "Amlodipin 5 mg",
          "offline": "amlodipine",
          "status": "agree"
        },
        {
          "name": "Glucophage",
          "offline": "metformin",
          "status": "mismatch"
        },
        {
          "name": "Zzyx",
          "offline": null,
          "status": "cloud_only"
        }
      ]
    }
  ],
  "groundedPlaces": [
    {
      "name": "only places Google Maps returned survive",
      "input": {
        "places": [
          {
            "name": "Apotek Kimia Farma Peunayong",
            "distanceKm": 1.2,
            "openNow": true
          },
          {
            "name": "Invented Clinic",
            "openNow": true
          }
        ],
        "chunks": [
          {
            "title": "Apotek Kimia Farma - Peunayong",
            "uri": "https://maps.google.com/?cid=1",
            "placeId": "places/abc"
          }
        ]
      },
      "expected": [
        {
          "name": "Apotek Kimia Farma Peunayong",
          "uri": "https://maps.google.com/?cid=1"
        }
      ]
    },
    {
      "name": "no grounding chunks means nothing is shown",
      "input": {
        "places": [
          {
            "name": "Apotek A"
          }
        ],
        "chunks": []
      },
      "expected": []
    }
  ],
  "askKit": [
    {
      "name": "valid card id is kept",
      "input": {
        "result": {
          "cardId": "a1",
          "answer": "Lunch is at 12:00 in the hall."
        },
        "cardIds": [
          "a1",
          "a2"
        ]
      },
      "expected": {
        "answer": "Lunch is at 12:00 in the hall.",
        "cardId": "a1"
      }
    },
    {
      "name": "unknown card id is discarded",
      "input": {
        "result": {
          "cardId": "zz",
          "answer": "The bus leaves at 9."
        },
        "cardIds": [
          "a1"
        ]
      },
      "expected": null
    },
    {
      "name": "null card id is discarded",
      "input": {
        "result": {
          "cardId": null,
          "answer": "Please ask a volunteer."
        },
        "cardIds": [
          "a1"
        ]
      },
      "expected": null
    }
  ],
  "helpTriage": [
    {
      "name": "AI says not urgent but the words say chest pain: urgent wins (never downgraded)",
      "input": {
        "text": "bapak saya nyeri dada sejak pagi",
        "ai": {
          "kind": "sick",
          "urgent": false,
          "summary": "Father has chest pain since morning"
        }
      },
      "expected": {
        "kind": "sick",
        "urgent": true,
        "summary": "Father has chest pain since morning",
        "by": "device"
      }
    },
    {
      "name": "no device model: keyword rules only, original words kept",
      "input": {
        "text": "Need insulin for my mother",
        "ai": null
      },
      "expected": {
        "kind": "medicine",
        "urgent": false,
        "summary": "Need insulin for my mother",
        "by": "keywords"
      }
    },
    {
      "name": "no keyword match: other",
      "input": {
        "text": "Where can I charge my phone?",
        "ai": null
      },
      "expected": {
        "kind": "other",
        "urgent": false,
        "summary": "Where can I charge my phone?",
        "by": "keywords"
      }
    },
    {
      "name": "no model, urgent words only: counted as sick",
      "input": {
        "text": "ibu pingsan",
        "ai": null
      },
      "expected": {
        "kind": "sick",
        "urgent": true,
        "summary": "ibu pingsan",
        "by": "keywords"
      }
    }
  ],
  "familyQr": [
    {
      "name": "round trip",
      "input": {
        "fam": "f-8c1e2b7a9d4f4a51b2c3",
        "me": {
          "id": "m1",
          "name": "Cut Nurlaila",
          "shelter": "SD3",
          "status": "safe",
          "at": 1000
        }
      },
      "expected": "NMF1:f-8c1e2b7a9d4f4a51b2c3:m1:SD3:safe:1000:Cut Nurlaila"
    },
    {
      "name": "names with colons survive",
      "input": {
        "fam": "f-8c1e2b7a9d4f4a51b2c3",
        "me": {
          "id": "m2",
          "name": "Teuku: Hasballah",
          "shelter": "MSJ1",
          "status": "need_help",
          "at": 2000
        }
      },
      "expected": "NMF1:f-8c1e2b7a9d4f4a51b2c3:m2:MSJ1:need_help:2000:Teuku: Hasballah"
    }
  ],
  "familyQrReject": [
    "hello",
    "NMF1:short:m1:SD3:safe:1:x",
    "NMF1:f-8c1e2b7a9d4f4a51b2c3:m1:SD3:dead:1:x",
    "NMF2:f-8c1e2b7a9d4f4a51b2c3:m1:SD3:safe:1:x"
  ],
