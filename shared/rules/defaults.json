  "routerPolicy": {
    "roster_read": {
      "sensitive": true,
      "cloudOnly": false,
      "schema": "roster",
      "model": "cloudAccurate"
    },
    "care_card_read": {
      "sensitive": true,
      "cloudOnly": false,
      "schema": "careCard",
      "model": "cloudAccurate"
    },
    "field_report": {
      "sensitive": true,
      "cloudOnly": false,
      "schema": "fieldReport",
      "model": "cloudAccurate"
    },
    "announcement": {
      "sensitive": false,
      "cloudOnly": false,
      "schema": "announcementCard",
      "model": "cloudLite",
      "deviceAccuracy": null,
      "cloudAccuracy": null
    },
    "announcement_id": {
      "sensitive": false,
      "cloudOnly": false,
      "schema": "announcementCard",
      "model": "cloudAccurate",
      "deviceAccuracy": 70,
      "cloudAccuracy": 92
    },
    "translate": {
      "sensitive": false,
      "cloudOnly": false,
      "schema": "translation",
      "model": "cloudAccurate"
    },
    "supply_request": {
      "sensitive": false,
      "cloudOnly": true,
      "schema": "request",
      "model": "cloudAccurate"
    },
    "med_check": {
      "sensitive": false,
      "cloudOnly": true,
      "schema": "medCheck",
      "model": "cloudAccurate",
      "_comment": "Input is drug names + strengths only, built by code (domain medCheckInput). Never names, beds or photos."
    },
    "find_open": {
      "sensitive": false,
      "cloudOnly": true,
      "schema": "findOpen",
      "model": "cloudAccurate",
      "grounding": "maps",
      "_comment": "Grounding with Google Maps. Location is rounded (findOpen.precisionDecimals) before it leaves the device."
    },
    "ask_kit": {
      "sensitive": false,
      "cloudOnly": false,
      "schema": "askKit",
      "model": "cloudLite",
      "_comment": "Answers only from today's shown notices; an answer without a valid cardId is discarded."
    },
    "help_triage": {
      "sensitive": true,
      "cloudOnly": false,
      "schema": "helpTriage",
      "model": "cloudLite",
      "_comment": "An evacuee's own words about their health: on this phone only. No device model -> keyword rules (no AI), never the cloud."
    },
    "family_query": {
      "sensitive": true,
      "cloudOnly": false,
      "schema": "familyQuery",
      "model": "cloudLite",
      "_comment": "Words about a missing relative stay on this phone; no device model -> the words are used as the name."
    },
    "name_variants": {
      "sensitive": false,
      "cloudOnly": true,
      "schema": "nameVariants",
      "model": "cloudAccurate",
      "_comment": "Only the name goes out (it is already in the public family index). Offline -> deterministic spelling rules."
    },
    "warning_plain": {
      "sensitive": false,
      "cloudOnly": false,
      "schema": "warningPlain",
      "model": "cloudAccurate",
      "_comment": "Official warning text -> plain words. Device first (no signal during evacuation); go-now words can only raise the level."
    },
    "warning_latest": {
      "sensitive": false,
      "cloudOnly": true,
      "schema": "warningPlain",
      "model": "cloudAccurate",
      "grounding": "search",
      "_comment": "Grounding with Google Search for the latest official BMKG/BPBD warning near a rounded location."
    },
    "pickup_request": {
      "sensitive": true,
      "cloudOnly": false,
      "schema": "pickup",
      "model": "cloudLite",
      "_comment": "Health + mobility words: on this phone only; no model -> keyword rules. Sent only when the person taps Send."
    },
    "checkin_parse": {
      "sensitive": true,
      "cloudOnly": false,
      "schema": "checkin",
      "model": "cloudLite",
      "_comment": "Volunteer's spoken check-in sentence -> name/age/flags, on this phone only; keyword flags are never dropped."
    }
  },
