{
  "type": "object",
  "required": ["meds"],
  "properties": {
    "meds": {
      "type": "array", "maxItems": 15,
      "items": {
        "type": "object",
        "required": ["nameAsWritten", "confidence"],
        "properties": {
          "nameAsWritten": { "type": "string", "maxLength": 80 },
          "strength": { "type": ["string", "null"], "maxLength": 30 },
          "doseAsWritten": { "type": ["string", "null"], "maxLength": 60 },
          "timesPerDay": { "type": ["integer", "null"], "minimum": 1, "maximum": 6 },
          "timing": { "type": ["string", "null"], "enum": ["before_meal", "after_meal", "with_meal", "bedtime", "any", null] },
          "qtyLeft": { "type": ["integer", "null"], "minimum": 0, "maximum": 1000 },
          "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
        }
      }
    },
    "conditions": { "type": "array", "maxItems": 10, "items": { "type": "string", "maxLength": 60 } },
    "allergies": { "type": "array", "maxItems": 10, "items": { "type": "string", "maxLength": 60 } }
  }
}
