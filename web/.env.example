# Copy to web/.env.local (never commit it). Without these the app runs in DEMO mode (canned AI, no Firebase).
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
VITE_FIREBASE_STORAGE_BUCKET=
VITE_FIREBASE_MESSAGING_SENDER_ID=
VITE_FIREBASE_APP_ID=
VITE_RECAPTCHA_ENTERPRISE_KEY=
# App Check debug token (register it in Firebase console > App Check > Manage debug tokens)
VITE_APPCHECK_DEBUG=true
VITE_APPCHECK_DEBUG_TOKEN=
# Use the Firebase Emulator Suite (auth 9099, firestore 8080)
VITE_USE_EMULATOR=false
