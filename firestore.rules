rules_version = '2';
// Staff write; public family search reads minimal fields only (D6); roles come from a membership record (D14).
service cloud.firestore {
  match /databases/{db}/documents {
    function signedIn() { return request.auth != null; }
    function member(shelterId) { return signedIn() && exists(/databases/$(db)/documents/shelters/$(shelterId)/members/$(request.auth.uid)); }
    function role(shelterId) { return get(/databases/$(db)/documents/shelters/$(shelterId)/members/$(request.auth.uid)).data.role; }

    match /shelters/{shelterId} {
      allow read: if member(shelterId);
      allow create: if signedIn();
      match /members/{uid} {
        allow read: if member(shelterId);
        // ponytail: join token is checked client-side from the signed QR; move to a callable function if abuse appears
        allow create: if signedIn() && request.auth.uid == uid && request.resource.data.role in ['volunteer', 'medic', 'organizer', 'scout'];
        allow delete: if member(shelterId) && role(shelterId) == 'organizer';
      }
      // Pickup requests: anyone (an evacuee at home) may ask; only members of this shelter can read them (wildcard rule below).
      match /pickups/{id} {
        allow create: if signedIn()
          && request.resource.data.keys().hasOnly(['id', 'who', 'lat', 'lng', 'mobility', 'needs', 'people', 'at', 'updatedAt'])
          && request.resource.data.who is string && request.resource.data.who.size() <= 40
          && request.resource.data.mobility is int && request.resource.data.mobility >= 0 && request.resource.data.mobility <= 3;
      }
      // Everything else in the shelter is for members, except the members list itself (no self-promotion).
      match /{col}/{id} { allow read, write: if member(shelterId) && col != 'members'; }
      match /{col}/{id}/{rest=**} { allow read, write: if member(shelterId) && col != 'members'; }
    }
    // Public family search index: minimal fields only, no flags, no health data.
    match /public/{id} {
      allow read: if true;
      allow write: if signedIn()
        && request.resource.data.keys().hasOnly(['name', 'age', 'shelterId', 'status', 'hidden', 'updatedAt'])
        && member(request.resource.data.shelterId);
    }
    // Supply requests + can't-miss alerts: counts only, no names.
    match /requests/{id} { allow create, update: if signedIn() && !('names' in request.resource.data); allow read: if signedIn(); }
    match /alerts/{id} { allow create, update: if signedIn() && request.resource.data.keys().hasOnly(['shelterId', 'counts', 'minSupplyDays', 'updatedAt']); allow read: if signedIn(); }
    match /fieldReports/{id} { allow create: if signedIn(); allow read: if signedIn(); }
    match /announcements/{id} { allow create: if signedIn(); allow read: if true; }
    match /roster/{id} { allow create: if signedIn(); }
    // Family group by QR: the random family id (f- + 20 hex) is the only key; minimal fields, no health data.
    match /families/{fid}/members/{mid} {
      allow read: if signedIn() && fid.matches('f-[0-9a-f]{20}');
      allow write: if signedIn() && fid.matches('f-[0-9a-f]{20}')
        && request.resource.data.keys().hasOnly(['name', 'shelter', 'status', 'at', 'updatedAt'])
        && request.resource.data.name is string && request.resource.data.name.size() <= 60
        && request.resource.data.status in ['safe', 'need_help'];
    }
  }
}
